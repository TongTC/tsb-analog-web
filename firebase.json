{
  "functions": {
    "source": "dist/analog/server"
  },
  "hosting": {
    "public": "dist/analog/public",
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "**",
        "function": "server"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
